{
  "name": "reimbursement-automation-iac",
  "version": "1.0.0",
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff"
  },
  "dependencies": {
    "aws-cdk-lib": "2.242.0",
    "cdk-nag": "^2.37.55",
    "constructs": "^10.4.2",
    "mustache": "^4.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "aws-cdk": "2.1112.0",
    "typescript": "^5.4.0",
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.12.7",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "prettier": "^3.2.5",
    "lint-staged": "^15.2.0",
    "husky": "^9.0.0"
  }
}
